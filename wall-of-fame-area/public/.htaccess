Options -Indexes
DirectoryIndex index.html
RewriteEngine On
RewriteRule ^api/(.*)$ api.php?route=$1 [QSA,L,NC]
<FilesMatch "^(api\.php|\.ht.*)$">
  Require all denied
</FilesMatch>
<Files "api.php">
  Require all granted
</Files>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "no-referrer"
